# Settings for the Shop Book app. Copy this file to .env and fill it in. Never commit .env.
# Nothing here is a secret, and nothing here is put into the app that phones download.

# Local development only (`npm run dev`): where Vite forwards /api requests.
# Your local backend's address, e.g. http://localhost:3000. Production uses vercel.json instead.
API_PROXY_TARGET=http://localhost:3000
